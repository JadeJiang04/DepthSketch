<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <uses-feature android:name="android.software.live_wallpaper" android:required="false" />
    <queries><intent><action android:name="android.service.wallpaper.CHANGE_LIVE_WALLPAPER" /></intent></queries>
    <application android:allowBackup="false" android:label="深绘" android:icon="@drawable/ic_launcher"
        android:theme="@style/AppTheme" android:largeHeap="true" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="portrait" android:configChanges="orientation|screenSize"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".CutoutActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".WallpaperPreviewActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".ReestimatedPreviewActivity" android:exported="false" android:screenOrientation="portrait" />
        <service android:name=".DepthWallpaperService" android:exported="true" android:permission="android.permission.BIND_WALLPAPER" android:label="深绘重力壁纸">
            <intent-filter><action android:name="android.service.wallpaper.WallpaperService" /></intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/wallpaper" />
        </service>
    </application>
</manifest>
